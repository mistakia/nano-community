.representatives__alerts.MuiTableContainer-root
  width auto
  .MuiTableRow-root
    background white
  .MuiTableBody-root .MuiTableRow-root:hover
    background #fafafa

.rep__alerts-guide
  padding 16px
  font-family 'Inter', sans-serif
  font-size 14px
  line-height 1.5
  color #666
  border-top 1px solid rgba(224, 224, 224, 1)

  a
    color #1976d2
    white-space nowrap

.rep__alert
  .MuiChip-label
    text-transform capitalize
    font-size 12px
    font-weight 600
    font-family 'IBM Plex Mono', monospace !important

  &.overweight
    background #E5F0F9

  &.low.uptime
  &.behind
    background darken(#FEF8EA, 10%)

  &.offline
    background lighten(#FFEFE2, 20%)
    color #bf4f4f
    border 1px solid #bf4f4f

.rep__alert-metric
  font-family 'IBM Plex Mono', monospace !important

  &.offline
    font-weight 600
    color #bf4f4f
