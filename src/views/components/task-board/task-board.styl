// Colours follow Base's task views: the stage and priority are coloured
// text, not filled chips.
$taskTertiary = #8a8a9a
$taskRule = #E4E4E4
$taskAccent = $nanoSoftBlue
$taskError = #b00020

$stageColors = {
  in_progress: #1976d2,
  needs_taker: #e65100,
  blocked: #d32f2f,
  triage: #7b1fa2,
  draft: #78828c,
  resolved: #2e7d32,
  closed: #616161
}

$priorityColors = {
  critical: #c62828,
  high: #e65100,
  medium: #a67c00,
  low: #558b2f
}

.task-board, .task-detail
  font-size 14px
  line-height 1.5
  color $textColor
  // clears the site's floating menu button
  padding 80px 32px 32px
  width 100%
  box-sizing border-box

  input, textarea, select
    font inherit
    font-size 13px
    padding 6px 8px
    border 1px solid $controlBorder
    border-radius 4px
    background white
    color $textColor
    box-sizing border-box

  code
    font-family 'Roboto Mono', monospace
    font-size 0.9em
    padding 0 3px
    border-radius 2px
    background rgba(0, 0, 0, 0.05)

  a
    color $taskAccent

// --- shared labels ----------------------------------------------------------

.task-stage, .task-priority, .task-state, .task-kind
  font-size 11px
  font-weight 600
  letter-spacing 0.04em
  text-transform uppercase
  white-space nowrap

for $name, $color in $stageColors
  .task-stage[data-stage={$name}]
    color $color

for $name, $color in $priorityColors
  .task-priority[data-priority={$name}]
    color $color

.task-state
  color $nanoBlueGrey

.task-kind
  display inline-block
  margin-right 6px
  padding 0 4px
  border 1px solid $taskRule
  border-radius 2px
  color $taskTertiary
  font-weight 500
  vertical-align 0.12em

.task-npub
  font-family 'Roboto Mono', monospace
  font-size 0.9em

.task-age, .task-muted
  color $taskTertiary

.task-board__error
  color $taskError
  margin-top 8px

.task-board__notice
  margin 16px 0
  display flex
  flex-wrap wrap
  gap 8px
  align-items center
  font-size 13px
  color $nanoBlueGrey

.task-section
  margin 24px 0
  padding-top 16px
  border-top 1px solid $taskRule

.task-section__title
  margin 0 0 12px
  font-size 11px
  font-weight 600
  letter-spacing 0.06em
  text-transform uppercase
  color $nanoBlueGrey

.task-section__count
  margin-left 6px
  color $taskTertiary
  font-weight 500

// The site is set in a monospace face, so code in a title needs no box.
.task-detail__subject code, .task-board__card-subject code, .task-new__preview-title code
  padding 0
  background none
  color $nanoBlueGrey

.task-text
  white-space pre-wrap
  overflow-wrap anywhere

// --- identity control -------------------------------------------------------

// A plain link in the page header: "Join in", or the name you post as.
.task-identity
  display inline-flex
  align-items center
  gap 6px
  max-width 240px
  font-size 13px
  white-space nowrap
  text-decoration none

  .task-board__name, .task-npub
    overflow hidden
    text-overflow ellipsis

  &:hover
    text-decoration underline

.task-identity__dot
  width 7px
  height 7px
  border-radius 50%
  background #e65100
  flex none

// --- account and new task pages ---------------------------------------------

.task-account, .task-new
  p
    margin 0 0 16px

.task-account__fine, .task-new__help
  font-size 12px
  color $taskTertiary

.task-account__fine
  .task-account &
    margin-top 12px

.task-new__help
  .task-new &
    margin 0

.task-copy
  display flex
  align-items center
  gap 4px
  margin 0 0 16px

.task-copy__value
  min-width 0
  font-family 'Roboto Mono', monospace
  font-size 12px
  color $nanoBlueGrey
  word-break break-all

.task-copy__show
  font-size 12px

.task-account__form, .task-new__step
  display flex
  flex-direction column
  align-items flex-start
  gap 8px
  margin-bottom 24px

  label
    font-weight 600

  input, textarea
    width 100%

.task-new__preview-title
  font-size 18px
  font-weight 600
  margin-bottom 8px

.task-new__preview
  .task-text
    margin-bottom 16px

  .task-new__help
    margin-bottom 16px

// --- board ------------------------------------------------------------------

.task-board__header
  position relative
  margin-bottom 24px
  text-align center

  h1
    margin 0 0 4px
    font-size 24px

  // The identity link sits apart from the centred title.
  .task-identity
    position absolute
    top 0
    right 0

.task-board__intro
  p
    margin 0 auto
    max-width 66ch
    color $nanoBlueGrey
    font-size 13px

.task-board__toolbar
  display flex
  justify-content center
  gap 12px
  align-items center
  margin-bottom 24px

.task-board__loading
  color $taskTertiary
  font-size 13px

.task-board__columns
  display flex
  gap 12px
  overflow-x auto
  align-items flex-start

.task-board__column
  flex 1 0 220px
  min-width 0
  background $backgroundColor
  border-radius 8px
  max-height 75vh
  display flex
  flex-direction column

.task-board__column--collapsed
  flex 0 0 auto

.task-board__column-title
  .task-board &
    display flex
    justify-content space-between
    align-items center
    gap 8px
    width 100%
    padding 10px 12px
    border none
    border-radius 8px
    background none
    color inherit
    font inherit
    text-align left
    cursor pointer

  h2
    margin 0
    font-size 11px
    font-weight 600
    letter-spacing 0.06em
    text-transform uppercase

for $name, $color in $stageColors
  .task-board__column[data-column={$name}] h2
    color $color

.task-board__count
  font-size 11px
  color $taskTertiary

.task-board__column-tasks
  overflow-y auto
  padding 0 8px 8px
  display flex
  flex-direction column
  gap 8px

.task-board__none
  padding 4px 4px 8px
  font-size 12px
  color $taskTertiary

.task-board__card
  display block
  background white
  border 1px solid $taskRule
  border-radius 4px
  padding 10px 12px
  color inherit
  text-decoration none

  .task-board &
    color $textColor

  &:hover
    border-color $controlBorder
    box-shadow $offsetShadow

.task-board__card-subject
  font-size 13px
  line-height 1.4
  margin-bottom 6px

.task-board__card-meta
  display flex
  flex-wrap wrap
  gap 4px 10px
  align-items center
  font-size 12px
  color $nanoBlueGrey

.task-board__empty
  padding 32px
  text-align center

// --- task page --------------------------------------------------------------

.task-detail
  max-width calc(66ch + 64px)
  margin 0 auto

.task-detail__top
  display flex
  justify-content space-between
  align-items center
  gap 16px
  margin-bottom 24px
  font-size 13px

  > a
    text-decoration none
    white-space nowrap

.task-detail__type
  font-size 11px
  letter-spacing 0.08em
  text-transform uppercase
  color $taskTertiary

.task-detail__subject
  margin 8px 0 16px
  font-size 24px
  line-height 1.25
  letter-spacing -0.01em

.task-detail__properties
  display grid
  grid-template-columns repeat(auto-fill, minmax(240px, 1fr))
  column-gap 32px
  margin 0 0 24px

.task-detail__property
  display flex
  align-items baseline
  min-height 28px
  gap 8px

  dt
    flex 0 0 96px
    font-size 12px
    color $taskTertiary

  dd
    margin 0
    font-size 13px
    min-width 0

.task-detail .task-text
  margin 0 0 24px

.task-detail__actions
  display flex
  gap 8px
  margin-bottom 24px

// A property value the viewer may change: plain text until hovered.
.task-inline
  display inline-flex
  align-items baseline
  gap 4px
  margin -2px -6px
  padding 2px 6px
  border 1px solid transparent
  border-radius 4px
  background none
  color inherit
  font inherit
  cursor pointer

  &:hover, &:focus-visible
    border-color $controlBorder

.task-inline__caret
  font-size 10px
  color $taskTertiary

.task-inline--staged
  border-style dashed
  border-color $controlBorder

.task-detail__save
  display flex
  flex-wrap wrap
  gap 8px
  align-items center
  margin -8px 0 24px
  font-size 12px
  color $nanoBlueGrey

  span
    flex 1 1 100%

.task-detail__buttons
  display flex
  gap 8px

.task-detail__comments
  form
    display flex
    flex-direction column
    gap 8px
    margin-top 16px

  textarea
    width 100%

.task-detail__comment
  padding 8px 0
  border-bottom 1px solid $taskRule

  &:last-of-type
    border-bottom none

.task-detail__comment-meta
  font-size 12px
  color $nanoBlueGrey
  margin-bottom 2px

// --- page chrome ------------------------------------------------------------

.task-board__footer
  padding 32px 0
  background $backgroundColor

@media (max-width 750px)
  .task-board, .task-detail
    padding 80px 16px 24px

  .task-board__header
    .task-identity
      position static
      margin-top 12px

  .task-board__columns
    flex-direction column
    align-items stretch
    overflow-x visible

  .task-board__column
    flex none
    max-height none

// --- key properties ---------------------------------------------------------

.task-properties__list
  grid-template-columns 1fr

  .task-detail__property dt
    flex-basis 120px

.task-properties__item
  display flex
  align-items baseline
  gap 8px

.task-properties__add, .task-properties__remove
  font-size 12px

.task-properties__add
  display inline-block
  margin 4px 0 8px

.task-properties__request
  display flex
  flex-wrap wrap
  align-items center
  gap 8px
  margin-bottom 12px
  font-size 13px
