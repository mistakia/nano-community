.block__note
  width 100%
  margin 8px 0

.block__note-body
  padding 16px
  border-radius 4px
  background white

.block__note-text
  font-family 'Inter', sans-serif
  font-size 14px
  white-space pre-wrap
  word-break break-word

.block__note-meta
  display flex
  justify-content space-between
  margin-top 12px
  font-size 12px
  opacity 0.7
