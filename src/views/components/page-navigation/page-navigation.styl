.page-navigation
  margin-bottom 32px
  padding-top 35px
  flex 1
  width 100%

.page-navigation__body
  flex 1 0 100%
  display flex
  flex-direction column
  align-items center

.page-navigation__wordmark
  font-family 'Montserrat', sans-serif
  font-size 32px
  letter-spacing 0.1em
  margin 48px auto 32px
  transition color 250ms cubic-bezier(0.4, 0, 0.2, 1) 0ms

a.page-navigation__wordmark:hover
  color $nanoSoftBlue
