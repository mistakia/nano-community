// the intro gets its own space; data sections share a tighter rhythm
$home_intro_space = 96px
$home_intro_break = 128px
$home_section_gap = 72px
$home_intro_space_narrow = 56px
$home_intro_break_narrow = 72px
$home_section_gap_narrow = 48px

.home__container
  margin 0 auto
  background white

  .menu__container .search__bar
    border 1px solid $borderColor

.home__intro
  max-width 720px
  margin $home_intro_space auto 0
  padding 0 16px
  text-align center

.home__intro-title
  font-family 'IBM Plex Mono', monospace
  font-size 40px
  font-weight 600
  letter-spacing -0.02em
  line-height 1.15
  margin 0 0 32px
  text-wrap balance

.home__intro-actions
  display flex
  justify-content center
  flex-wrap wrap
  gap 12px

.home__properties
  display grid
  grid-template-columns repeat(3, 1fr)
  column-gap 48px
  row-gap 40px
  max-width 960px
  margin $home_intro_space auto $home_intro_break
  padding 0 16px
  text-align center

.home__property-title
  font-family 'IBM Plex Mono', monospace
  font-size 11px
  font-weight 600
  letter-spacing 0.16em
  text-transform uppercase
  margin-bottom 8px

.home__property-text
  font-family 'Inter', sans-serif
  font-size 15px
  line-height 1.5
  color rgba(0, 0, 0, 0.6)
  text-wrap balance

.home__body
  max-width 1000px
  overflow hidden
  margin 0 auto
  padding 0 16px

.home__sections
  display flex
  flex-wrap wrap
  align-items stretch
  margin-bottom $home_section_gap

  .network__container
  .github__container
    margin-top 0

  // section titles carry their own top padding
  .network__title
  .github__title
    padding-top 0

.home__body .community-feed
  margin-bottom 0

.home__footer
  display flex
  flex-direction column
  align-items center
  margin-top $home_section_gap

  .menu__container
    padding-top $home_section_gap_narrow

@media (min-width 750px)
  .home__body
    border-radius 16px

@media (max-width 749px)
  .home__intro
    margin-top $home_intro_space_narrow

  .home__intro-title
    font-size 28px
    margin-bottom 24px

  .home__intro-actions
    flex-direction column
    align-items stretch
    max-width 320px
    margin 0 auto

  .home__properties
    grid-template-columns repeat(2, 1fr)
    column-gap 24px
    row-gap 32px
    margin $home_intro_space_narrow auto $home_intro_break_narrow

  .home__sections
    margin-bottom $home_section_gap_narrow
    row-gap $home_section_gap_narrow

  .home__footer
    margin-top $home_section_gap_narrow
