// one content edge for every block; the intro gets its own space, then the
// properties with their live proof, then the data. Only the footer menu is boxed.
$home_width = 992px
$home_group_gap = 48px
$home_intro_space = 96px
$home_intro_space_narrow = 56px
$home_gutter_narrow = 16px

.home__container
  margin 0 auto
  background white

// the header is one slim bar on the content edge, so the headline is the only centered focus
.home__container > .menu__container
  margin 0
  padding-top 20px

  .menu__body
    flex-direction row
    justify-content space-between
    max-width $home_width
    min-height 56px
    margin 0 auto
    padding 0 16px

  .menu__text
    font-size 24px
    margin 0

  .search__bar
    height 40px
    margin 0
    border 1px solid $borderColor

.home__intro
.home__properties
.home__highlights
.home__body
  max-width $home_width
  margin-left auto
  margin-right auto
  padding 0 16px

.home__intro
  max-width 720px
  margin-top $home_intro_space
  text-align center

.home__intro-title
  font-family 'IBM Plex Mono', monospace
  font-size 40px
  font-weight 600
  letter-spacing -0.02em
  line-height 1.15
  margin 0 0 32px
  text-wrap balance

.home__intro-actions
  display flex
  justify-content center
  flex-wrap wrap
  gap 12px

.home__properties
  display grid
  grid-template-columns repeat(3, 1fr)
  column-gap 48px
  row-gap 40px
  margin-top $home_intro_space
  margin-bottom $home_group_gap

.home__property-title
  font-family 'IBM Plex Mono', monospace
  font-size 20px
  font-weight 600
  letter-spacing -0.01em
  margin-bottom 6px

.home__property-text
  font-family 'Inter', sans-serif
  font-size 15px
  line-height 1.5
  color rgba(0, 0, 0, 0.6)
  text-wrap pretty

.home__highlights
  margin-bottom $home_group_gap

.home__sections
  display grid
  grid-template-columns 1fr 1fr
  column-gap 48px
  margin-bottom $home_group_gap

  .network__container
  .github__container
    margin 0
    padding 0
    border-radius 0

  .network__stat:last-child
  .github__event:last-child
    border-bottom none

  .github__events
    padding 0

// the feed drops its tray and card and reads as a plain list like the sections
.home__body .community-feed
  margin-bottom 0
  padding 0
  border none
  border-radius 0
  background none

  .header__container
    margin 0
    padding 0

  .community-feed__tabs
    margin 0 0 8px
    gap 24px

  .community-feed__tab
    font-size 12px
    font-weight 800
    letter-spacing 0.2em
    text-transform uppercase

  .posts__body
    margin 0
    box-shadow none
    border-radius 0
    background none

  .post
    background none
    border-bottom 1px solid $borderColor
    &:last-child
      border-bottom none

  .post__title
    padding 14px 0 0

  .post__meta
    padding 8px 0 14px

// the footer keeps the site's boxed menu, at the width it had before
.home__footer
  max-width 1134px
  margin $home_group_gap auto 0
  padding 0 16px $home_group_gap

// clear the fixed menu button until the content edge moves past it
@media (min-width 750px) and (max-width 1150px)
  .home__container > .menu__container .menu__body
    padding-left 88px

@media (max-width 749px)
  .home__container > .menu__container
    .menu__body
      flex-wrap wrap
      padding 0 $home_gutter_narrow

    .search__bar
      flex 1 0 100%
      max-width none
      margin-top 16px

      .search__input
        flex 1
        width auto

  .home__intro
  .home__properties
  .home__highlights
  .home__body
  .home__footer
    padding-left $home_gutter_narrow
    padding-right $home_gutter_narrow

  .home__intro
    margin-top $home_intro_space_narrow

  .home__intro-title
    font-size 28px
    margin-bottom 24px

  .home__intro-actions
    flex-direction column
    align-items stretch
    max-width 320px
    margin 0 auto

  .home__properties
    grid-template-columns repeat(2, 1fr)
    column-gap 24px
    row-gap 28px
    margin-top $home_intro_space_narrow
    margin-bottom 40px

  .home__property-title
    font-size 16px

  .home__property-text
    font-size 14px

  .home__highlights
    margin-bottom 40px

  .home__sections
    grid-template-columns 1fr
    row-gap 40px
    margin-bottom 40px

  // the menu boxes carry their own 8px margin
  .home__footer
    padding-left $home_gutter_narrow - 8px
    padding-right $home_gutter_narrow - 8px
