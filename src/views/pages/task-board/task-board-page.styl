.task-board__discussions
  padding 0 24px
  font-size 14px
  font-family 'Roboto Mono', monospace
  line-height 1.6
  background $backgroundColor

.task-board__discussions-body
  margin 0 8px 32px
  min-height 48px
  position relative

  .MuiAccordionDetails-root
    flex-wrap wrap
    padding 0 30px

@media (min-width 750px)
  .task-board__discussions
    border 1px solid lighten($borderColor, 40%)
    border-radius 4px

@media (min-width 900px)
  .task-board__discussions
    max-width 800px
    margin 32px auto 64px
