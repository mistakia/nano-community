# Daily delta archive: reads the rows past each table's etl_state watermark
# from VPS PG (autossh tunnel) and inserts them into PG/Timescale
# nano_community_archive on database-server. It deletes nothing on the VPS:
# TimescaleDB retention policies there drop old chunks. The flock is shared
# with schema changes to the archive. See
# user:task/homelab/cutover-nano-community-archive-crons.md.
0 1 * * * flock -n /tmp/nano-community-archive.lock job-wrapper.sh nano-community-archive-postgres env NODE_ENV=production /home/user/.local/share/fleet-node/bin/node /home/user/nano-community/scripts/archive-to-postgres.mjs --delta >> /var/log/nano-community/archive-to-postgres.log 2>&1
